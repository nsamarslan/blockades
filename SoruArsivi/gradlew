#!/bin/sh
#
# Gradle start up script for POSIX generated for the SoruArsivi project.
#

set -e

# Resolve the directory this script lives in, following symlinks.
PRG="$0"
while [ -h "$PRG" ]; do
    ls=$(ls -ld "$PRG")
    link=$(expr "$ls" : '.*-> \(.*\)$')
    case "$link" in
        /*) PRG="$link" ;;
        *)  PRG=$(dirname "$PRG")/"$link" ;;
    esac
done
APP_HOME=$(cd -P "$(dirname "$PRG")" > /dev/null && pwd)

CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$CLASSPATH" ]; then
    echo "ERROR: gradle/wrapper/gradle-wrapper.jar bulunamadi." >&2
    exit 1
fi

# Locate a Java runtime.
if [ -n "$JAVA_HOME" ]; then
    if [ -x "$JAVA_HOME/jre/sh/java" ]; then
        JAVACMD="$JAVA_HOME/jre/sh/java"
    else
        JAVACMD="$JAVA_HOME/bin/java"
    fi
    if [ ! -x "$JAVACMD" ]; then
        echo "ERROR: JAVA_HOME gecerli bir Java kurulumunu gostermiyor: $JAVA_HOME" >&2
        exit 1
    fi
else
    JAVACMD="java"
    if ! command -v java > /dev/null 2>&1; then
        echo "ERROR: Java bulunamadi. JAVA_HOME ayarlayin veya java'yi PATH'e ekleyin." >&2
        exit 1
    fi
fi

# Increase the maximum file descriptors if we can (large builds need them).
if [ "$(uname)" != "Darwin" ] && command -v ulimit > /dev/null 2>&1; then
    MAX_FD=$(ulimit -H -n 2> /dev/null) || MAX_FD=""
    case "$MAX_FD" in
        '' | unlimited | *[!0-9]*) : ;;
        *) ulimit -n "$MAX_FD" 2> /dev/null || : ;;
    esac
fi

exec "$JAVACMD" \
    $JAVA_OPTS $GRADLE_OPTS \
    "-Dorg.gradle.appname=$(basename "$0")" \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"
